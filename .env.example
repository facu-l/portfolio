# Copiar a .env.local y completar. .env.local NO se versiona.
#
# OJO: las variables NEXT_PUBLIC_ se reemplazan en tiempo de BUILD.
# Cambiarlas en Vercel no hace efecto hasta que redeployes.

# URL absoluta del sitio. La usan las metatags de Open Graph.
# Sin esto cae a http://localhost:3000 y el preview al compartir el link se rompe.
NEXT_PUBLIC_SITE_URL=

# Access key de Web3Forms (https://web3forms.com) para el formulario de contacto.
# Es publica por diseno: viaja en el body de un POST desde el navegador.
# Sin esto, la seccion Contact muestra los links sociales en vez del formulario.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
